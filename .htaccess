# Fuar Çiçekçim — Apache ayarları (cPanel / LiteSpeed uyumlu)
Options -Indexes
AddDefaultCharset UTF-8
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) HTTPS + www'ye yönlendir  (SSL kurulmadan sorun çıkarsa bu iki RewriteCond/RewriteRule satırının başına # koyun)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301]

  # 2) /sayfa  →  /sayfa.html  (uzantısız temiz URL'ler de çalışsın)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([^.]+)$ $1.html [L]

  # 3) Eski GitHub Pages yolları
  RewriteRule ^tuyap-ifm/?(.*)$ /$1 [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

# Hassas dosyalar
<FilesMatch "^(config\.php|README.*|\.git.*|.*\.md)$">
  Require all denied
</FilesMatch>

# Güvenlik başlıkları
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # 1 yıl önbellek: görseller ve fontlar
  <FilesMatch "\.(webp|jpe?g|png|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # CSS/JS: 1 hafta (sürüm parametresi ile yenilenir)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Sıkıştırma
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json image/svg+xml
</IfModule>

# MIME
AddType image/webp .webp
AddType font/woff2 .woff2
