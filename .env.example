# Tarayıcı yapılandırması: yalnız PUBLIC / PUBLISHABLE bilgiler.
# Gerçek değerleri Git'e girmeyen .env.local dosyasında tutun.
# SQL, kullanıcı yetkileri ve PHP ortamı hazır olmadan etkinleştirmeyin.
VITE_SUPABASE_ENABLED=false
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Canlı katalog katmanı (fiyat, stok, aç/kapat, sıralama, rozet, indirim anında): sayfalar bu bayrakla derlenirse
# Supabase'ten fc_live_products okur (aynı URL ve publishable anahtarı kullanır). Kapalıyken site yalnız statik katalogla çalışır.
# Yalnız 002_live_catalog.sql çalıştırıldıktan ve sunucu doğrulaması (teklif-gonder.php) hazır olduktan sonra true yapın.
# Sunucu karşılığı: fuar-private/server.env içinde LIVE_CATALOG_ENABLED=true (+ SUPABASE_URL ve SUPABASE_PUBLISHABLE_KEY);
# ikisi birlikte açılır, yeni PHP dosyaları (api/lib/live-catalog.php dahil) yüklendikten SONRA. Ayrıntı: supabase/README.md.
VITE_LIVE_CATALOG_ENABLED=false

# SUPABASE_SECRET_KEY / service_role bu dosyaya veya VITE_* değişkenine EKLENMEZ.
# PHP sunucu ortamı ayrı yapılandırılır; site/supabase/README.md dosyasını izleyin.
